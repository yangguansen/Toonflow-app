SUPABASE_URL=https://your-dev-project.supabase.co
SUPABASE_ANON_KEY=your-dev-anon-key
# 仅服务端使用，用于容器重启后恢复 AI 任务；禁止写入前端或提交到 Git。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_OAUTH_PROVIDERS=github,google
TOONFLOW_ADMIN_EMAILS=admin@example.com
TOONFLOW_APP_VERSION=2.0.0
TOONFLOW_BIND_ADDRESS=127.0.0.1
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
# AI 积分计费默认关闭；执行 supabase/migrations/creditLedger.sql 后再启用。
# 1 积分对应 $0.001 上游成本；每笔任务按加价后的积分结果四舍五入。
TOONFLOW_CREDITS_ENABLED=false
TOONFLOW_CREDIT_USD=0.001
TOONFLOW_CREDIT_MARKUP_RATE=1.3
# 可选：按 Provider ID 覆盖完整非敏感配置和 apiKey，值为一行 JSON。
# TOONFLOW_PROVIDER_CONFIGS={"autodl":{"apiKey":"...","baseUrl":"...","workflowId":"..."}}
# 生产环境配置公开访问地址；本地可留空，自动使用当前请求域名。
# TOONFLOW_PUBLIC_URL=https://toonflow.example.com
# 生产环境使用 HTTPS 时设置为 true；本地 http://127.0.0.1 保持 false。
# TOONFLOW_COOKIE_SECURE=true
